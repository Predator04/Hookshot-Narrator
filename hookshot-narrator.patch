+int rx_option(int id, int otherwise);
+enum { OPT_VOICE_ON = 70, OPT_VOICE_KIND, OPT_VOICE_SPEED, OPT_VOICE_GLOW, OPT_LINK_VOICE, OPT_LINK_PITCH };   /* (gpu/vk/vk_api.h HOS_OPT_VOICE_*) */
