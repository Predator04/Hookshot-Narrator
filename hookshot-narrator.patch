+/* the message as words: tags out, newlines to spaces; 0 when it has no letters */
+static int message_words(uint64_t text, uint32_t len, wchar_t *out, int max) {
+    unsigned char b[MAXT];
+    if (len >= sizeof b) len = sizeof b - 1;
+    memcpy(b, A64_PTR(text), len);
+    b[len] = 0;
+    char plain[MAXT];
+    int n = 0, letters = 0;
+    for (uint32_t i = 0; i < len && b[i]; i++) {
+        if (b[i] == 0x0e && i + 6 < len) {   /* tag: group, tag, size, parameters */
+            const unsigned group = b[i + 1] | b[i + 2] << 8, tag = b[i + 3] | b[i + 4] << 8, size = b[i + 5] | b[i + 6] << 8;
+            {   /* (each kind of tag once in the log: a name or item said nowhere shows up here) */
+                static unsigned seen[64];
+                static int nseen;
+                const unsigned id = group << 16 | tag;
+                int known = 0;
+                for (int q = 0; q < nseen; q++) known |= seen[q] == id;
+                if (!known && nseen < 64) {
+                    seen[nseen++] = id;
+                    char hex[3 * 24 + 1] = "";
+                    for (unsigned q = 0; q < size && q < 24 && i + 7 + q < len; q++) snprintf(hex + 3 * q, 4, "%02x ", b[i + 7 + q]);
+                    hos_log("voice: message tag %u/%u, %u bytes: %s", group, tag, size, hex);
+                }
+            }
+            if (group == 2 && size >= 2 && i + 7 + size <= len) {   /* (a game variable: its value said in its place) */
+                const unsigned nl = b[i + 7] | b[i + 8] << 8;
+                int value;
+                static int logged;
+                char word[96];
+                int got = 0;
+                if (nl && 2 + nl <= size) {
+                    got = game_number((const char *)b + i + 9, nl, &value);
+                    if (!got) got = message_argument((const char *)b + i + 9, nl, &value, word, sizeof word);
+                }
+                if (got == 1) {
+                    if (n < (int)sizeof plain - 16) n += snprintf(plain + n, 16, "%d", value);
+                    letters++;
+                } else if (got == 2) {
+                    for (const char *w = word; *w && n < (int)sizeof plain - 1; w++) plain[n++] = *w;
+                    letters += 2;
+                } else if (logged < 20) {
+                    logged++, hos_log("voice: message variable %u/%u \"%.*s\" not found", group, tag, (int)nl, (const char *)b + i + 9);
+                }
+            }
+            i += 6 + size;
+            continue;
+        }
+        if (b[i] == 0x0f && i + 4 < len) { i += 4; continue; }   /* (a closing tag: group, tag) */
+        unsigned char ch = b[i] == '\n' || b[i] == '\r' ? ' ' : b[i];
+        if (ch < 0x20) continue;
+        if (ch == ' ' && n > 0 && plain[n - 1] == ' ') continue;
+        if ((ch | 0x20) >= 'a' && (ch | 0x20) <= 'z') letters++;
+        if (n < (int)sizeof plain - 1) plain[n++] = (char)ch;
+    }
+    plain[n] = 0;
+    if (letters < 2) return 0;
+    return MultiByteToWideChar(CP_UTF8, 0, plain, -1, out, max) > 0;
+}
