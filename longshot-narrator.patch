+int rx_option(int id, int otherwise);
+enum { OPT_VOICE_ON = 70, OPT_VOICE_KIND, OPT_VOICE_SPEED, OPT_VOICE_GLOW, OPT_LINK_VOICE, OPT_LINK_PITCH };   /* (76 was the update check: removed, kept free) */   /* (gpu/vk/vk_api.h HOS_OPT_VOICE_*) */
