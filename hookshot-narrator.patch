+/* The choice menu (found 2026-11-12 on "Death Mountain? / Bye."): global 0x84ea4510 -> +0x200 -> +0x1b8 is the choice
+   window; its buttons at +0x418 + 0x20*i, each pointing into a block that holds the choice's text object {u32 length,
+   ..., text pointer at +0x40} somewhere in its first 0x2000 bytes; the highlighted one (from 0) at window +0x85c.
+   Returns a signature of the choices (0: no menu); the list as "A. B. C." and/or the highlighted one's words. */
+#define CHOICE_ROOT 0x84ea4510ULL
+static int safe_read(uint64_t a, void *out, size_t n) {   /* (never faults: a menu's memory may be half gone) */
+    SIZE_T got = 0;
+    return ReadProcessMemory(GetCurrentProcess(), A64_PTR(a), out, n, &got) && got == n;
+}
+static uint64_t s64(uint64_t a) { uint64_t v = 0; return safe_read(a, &v, 8) ? v : 0; }
+/* why the menu was not read, logged when it changes (so a run shows where it stops) */
+static void choice_why(int why, uint32_t a, uint32_t b) {
+    static int last = -1, told;
+    if (why == last || told >= 60) return;
+    last = why, told++;
+    static const char *const say[] = {"choice menu read", "choice window not found via 0x84ea4510 -> +0x200",
+                                      "choice window: no count/cursor", "choice window: count/cursor out of range",
+                                      "choice button not readable", "choice button: no text object", "choice text has no words"};
+    hos_log("voice: %s (last choice %u, cursor %u)", say[why], a, b);
+}
+static uint32_t choice_menu(wchar_t *list, int lmax, int *cursor, wchar_t *one, int omax) {
+    if (list && lmax) list[0] = 0;
+    if (one && omax) one[0] = 0;
+    const uint64_t r = s64(CHOICE_ROOT);
+    const uint64_t n = r ? s64(r + 0x200) : 0;
+    if (!n) return choice_why(1, 0, 0), 0;
+    const uint64_t w = n + 0x1b8;   /* (the window: +0x4d0 the last choice's index, +0x4e4 the highlighted one; seen with
+                                       3 choices (2) and 2 (1)) */
+    uint32_t last, cur;
+    if (!safe_read(w + 0x4d0, &last, 4) || !safe_read(w + 0x4e4, &cur, 4)) return choice_why(2, 0, 0), 0;
+    if (last < 1 || last > 3 || cur > last) return choice_why(3, last, cur), 0;
+    uint32_t sig = 2166136261u;
+    int l = 0;
+    static unsigned char blk[0x2048];
+    for (uint32_t i = 0; i <= last; i++) {
+        const uint64_t b = s64(w + 0x418 + 0x20 * i);
+        if (!b || !safe_read(b, blk, sizeof blk)) return choice_why(4, last, cur), 0;
+        unsigned char tx[256];
+        wchar_t wd[256];
+        int found = 0;   /* (the first candidate {length, ..., text at +0x40} whose text has words: junk can come first) */
+        for (uint32_t o = 0; o + 0x48 <= sizeof blk && !found; o += 8) {
+            uint32_t L;
+            uint64_t t;
+            memcpy(&L, blk + o, 4), memcpy(&t, blk + o + 0x40, 8);
+            if (L < 2 || L > 200 || !safe_read(t, tx, L + 1) || tx[L]) continue;
+            uint32_t k = 0;
+            while (k < L && (tx[k] >= 32 || tx[k] == 10 || tx[k] == 14) && tx[k] != 127) k++;
+            if (k == L && message_words(t, L, wd, 256)) found = 1;
+        }
+        if (!found) return choice_why(5, last, cur), 0;
+        for (const wchar_t *c = wd; *c; c++) sig = (sig ^ (uint32_t)*c) * 16777619u;
+        if (list && l < lmax - 4) {
+            l += swprintf(list + l, (size_t)(lmax - l), L"%ls%ls", l ? L" " : L"", wd);
+            const wchar_t e = l ? list[l - 1] : 0;
+            if (e != L'.' && e != L'?' && e != L'!' && l < lmax - 2) list[l++] = L'.', list[l] = 0;
+        }
+        if (one && i == cur) wcsncpy(one, wd, (size_t)omax - 1), one[omax - 1] = 0;
+    }
+    choice_why(0, last, cur);
+    *cursor = (int)cur;
+    return sig;
+}
+
+static DWORD WINAPI voice_thread(void *arg) {
+    (void)arg;
+    if (FAILED(CoInitializeEx(NULL, COINIT_MULTITHREADED))) return 0;
+    ISpVoice *v = NULL;
+    if (FAILED(CoCreateInstance(&my_CLSID_SpVoice, NULL, CLSCTX_ALL, &my_IID_ISpVoice, (void **)&v)) || !v) {
+        hos_log("voice: no Windows voice (SAPI) here; read-aloud off");
+        return 0;
+    }
+    const char *r = getenv("HOS_VOICE_RATE");
+    ISpVoice_SetRate(v, r && *r ? atoi(r) : -1);
+    hos_log("voice: read-aloud ready (Windows voice, the dialogue box's message; HOS_VOICE=0 turns it off)");
+    uint64_t last_text = 0;
+    uint32_t last_hash = 0;
+    int64_t pending_at = 0;
+    int speaking = 0;   /* (1 the Windows voice, 2 piper until piper_until) */
+    int64_t piper_until = 0;
+    wchar_t words[MAXT];
+    for (;;) {
+        Sleep(100);
+        const int64_t now = hos_now_ns();
+        const uint64_t obj = g64(MSG_HOLDER);
+        static uint64_t seen_obj = 1;
+        static int diag;
+        if (obj != seen_obj && diag < 40) {
+            diag++, seen_obj = obj;
+            hos_log("voice: message object %#llx text %#llx len %u", (unsigned long long)obj,
+                    in_heap(obj) ? (unsigned long long)g64(obj + MSG_TEXT) : 0ULL, in_heap(obj) ? g32(obj + MSG_LEN) : 0u);
+        }
+        if (in_heap(obj)) {
+            /* (the message's pages are a ring of nodes {prev, next, flags, len, text...}; +0x58 is the first page's
+               text, +0x48 the page on show, 1 for the first: walk to it) */
+            uint64_t text = g64(obj + MSG_TEXT);
+            uint32_t len = g32(obj + MSG_LEN);
+            const uint32_t page = g32(obj + MSG_PAGE);
+            if (page > 1 && page < 64 && in_heap(text - 0x20)) {
+                const uint64_t first = text - 0x20, head = g64(first);
+                uint64_t node = first;
+                for (uint32_t k = 1; k < page && node; k++) {
+                    node = in_heap(node) ? g64(node + 8) : 0;
+                    if (node == head || node == first || !in_heap(node)) node = 0;
+                }
+                if (node) text = node + 0x20, len = g32(node + 0x18);
+            }
+            if (in_heap(text) && len > 0 && len < 8192) {
+                uint32_t h = 2166136261u;
+                for (uint32_t i = 0; i < len && i < 4096; i++) h = (h ^ *(const unsigned char *)A64_PTR(text + i)) * 16777619u;
+                if (text != last_text || h != last_hash) {
+                    if (diag < 40) diag++, hos_log("voice: new text at %#llx, %u bytes", (unsigned long long)text, len);
+                    static int first = 1;   /* (the message already there when the thread first looks is not new) */
+                    last_text = text, last_hash = h;
+                    glow(0);
+                    if (speaking) hush(v), speaking = 0;   /* (a new page: the last one's voice stops) */
+                    /* (closing the box drops the page back to 1: the same message's first page again is not new) */
+                    static uint32_t page1_hash, last_page;
+                    const uint32_t pg = page < 64 ? page : 1;
+                    const int back_to_start = pg <= 1 && last_page > 1 && h == page1_hash;
+                    if (pg <= 1) page1_hash = h;
+                    last_page = pg;
+                    if (back_to_start) {
+                        if (diag < 40) diag++, hos_log("voice: back to page 1 of the same message (box closed), not read again");
+                        pending_at = 0;
+                    } else if (message_words(text, len, words, MAXT)) pending_at = now;
+                    first = 0;
+                }
+            }
+        }
+        if (!rx_option(OPT_VOICE_ON, 1)) {   /* (the Insert menu's Read aloud row off) */
+            pending_at = 0;
+            if (speaking) hush(v), speaking = 0;
+            glow(0);
+        }
+        if (pending_at && now - pending_at > 300000000LL) {
+            pending_at = 0;
+            /* (the same prompt again within one conversation, as after a choice is answered: read once; 45 s later it is a
+               new conversation) */
+            static uint32_t heard[16];
+            static int64_t heard_at[16];
+            uint32_t wh = 2166136261u;
+            for (const wchar_t *w = words; *w; w++) wh = (wh ^ (uint32_t)*w) * 16777619u;
+            int again = 0, slot = 0;
+            for (int q = 0; q < 16; q++) {
+                if (heard[q] == wh && now - heard_at[q] < 45000000000LL) again = 1, slot = q;
+                else if (heard_at[q] < heard_at[slot]) slot = q;
+            }
+            heard[slot] = wh, heard_at[slot] = now;
+            if (again) {
+                static int told;
+                if (told < 20) told++, hos_log("voice: heard just now, not read again: \"%.50ls\"", words);
+                glow(rx_option(OPT_VOICE_GLOW, 1));
+                continue;
+            }
+            static int said;
+            if (hos_voiced_line_ns > now - 2400000000LL) {
+                if (said < 30) said++, hos_log("voice: skipped, the game voices it: \"%.60ls\"", words);
+            } else {
+                speak(v, words, 1, &speaking, &piper_until);
+            }
+        }
+        {   /* (Link's voice or pitch changed in the menu: a sample) */
+            static int lv = -1, lp = -1;
+            const int v2 = rx_option(OPT_LINK_VOICE, 0), p2 = rx_option(OPT_LINK_PITCH, 3);
+            if (lv >= 0 && (v2 != lv || p2 != lp) && rx_option(OPT_VOICE_ON, 1)) {
+                if (speaking) hush(v), speaking = 0;
+                speak(v, L"Hi! I'm Link! Let's go!", 0, &speaking, &piper_until);
+            }
+            lv = v2, lp = p2;
+        }
+        /* the choice list: read once after its prompt, then the highlighted choice as the cursor moves */
+        {
+            static uint32_t shown_sig;
+            static int shown_cursor = -1, choices_due;
+            static wchar_t list[MAXT];
+            int cursor;
+            const uint32_t sig = in_heap(obj) ? choice_menu(list, MAXT, &cursor, NULL, 0) : 0;
+            if (!in_heap(obj)) shown_sig = 0, choices_due = 0;   /* (no box: the next menu is new, even the same one) */
+            if (sig && sig != shown_sig) {
+                shown_sig = sig, shown_cursor = cursor, choices_due = 1;
+                static int lg;
+                if (lg < 20) lg++, hos_log("voice: choices %08x, cursor %d: \"%.80ls\"", sig, cursor, list);
+            } else if (sig && cursor != shown_cursor && rx_option(OPT_VOICE_ON, 1)) {
+                shown_cursor = cursor, choices_due = 0, pending_at = 0;
+                wchar_t one[256];
+                if (choice_menu(NULL, 0, &cursor, one, 256)) {
+                    glow(0);
+                    if (speaking) hush(v), speaking = 0;
+                    speak(v, one, 0, &speaking, &piper_until);
+                }
+            }
+            if (choices_due && !pending_at && !speaking && rx_option(OPT_VOICE_ON, 1)) {   /* (after the prompt) */
+                choices_due = 0;
+                glow(0);
+                speak(v, list, 0, &speaking, &piper_until);
+            }
+        }
+        if (speaking && hos_voiced_line_ns > now - 150000000LL) {   /* (the game began a voiced line: ours stops) */
+            hush(v);
+            speaking = 0;
+        }
+        if (speaking == 1 && !pending_at) {   /* (the page read to its end: the rainbow says "press next") */
+            SPVOICESTATUS st;
+            if (SUCCEEDED(ISpVoice_GetStatus(v, &st, NULL)) && st.dwRunningState == SPRS_DONE)
+                speaking = 0, glow(rx_option(OPT_VOICE_GLOW, 1));
+        }
+        if (speaking == 2 && !pending_at && now > piper_until) speaking = 0, glow(rx_option(OPT_VOICE_GLOW, 1));
+        if (glow_flag && *glow_flag && now - glow_since > 60000000000LL) glow(0);   /* (a minute: whatever it was, gone) */
+    }
+}
+
+void hos_oot_voice_start(void) {
+    static volatile LONG started;
+    if (InterlockedExchange(&started, 1)) return;
+    const char *e = getenv("HOS_VOICE");
+    if (e && *e && atoi(e) == 0) return;
+    CloseHandle(CreateThread(NULL, 0, voice_thread, NULL, 0, NULL));
+}
+void hos_oot_voice_pane(Ctx *c, uint64_t pane) { (void)c, (void)pane; hos_oot_voice_start(); }
+#else
+void hos_oot_voice_start(void) {}
+void hos_oot_voice_pane(Ctx *c, uint64_t pane) { (void)c, (void)pane; }
+#endif
