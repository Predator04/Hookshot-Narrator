diff --git a/host/oot_voice.c b/host/oot_voice.c
new file mode 100644
index 0000000..52c95c9
--- /dev/null
+++ b/host/oot_voice.c
@@ -0,0 +1,731 @@
+/* (local) Read-aloud: the lines characters say in their dialogue box, spoken with Windows' own voice (SAPI), for a player
+   who cannot read yet.
+
+   The message on show: found on 2026-11-11 with the Master Craftsman's box up, the guest pointer at 0x84e990b8 (main's
+   data) holds an object whose +0x58 is the message's text (UTF-8) and +0x60 its length in bytes. The text carries tags,
+   0x0E u16 group, u16 tag, u16 size, then size bytes of parameters (the first ones are the box's mood, "Greeting" and so
+   on), which are left out, as are newlines. A thread looks every 100 ms; a new message is spoken after 0.4 s, unless the
+   game opened a voiced line's stream (host/nn_fs.c, hos_voiced_line_ns) around it: then its actor speaks instead.
+
+   HOS_VOICE=0: off. HOS_VOICE_RATE=-10..10 (default -1, a little slow). */
+#include "hos.h"
+#include <stdlib.h>
+#include <string.h>
+#include <math.h>
+#include <wchar.h>
+
+volatile long long hos_voiced_line_ns;
+volatile uint64_t hos_oot_gamedata_mgr;   /* (host/hos_main.c, on Link's update) */   /* (host/nn_fs.c: when the game last opened a voiced line's stream) */
+
+#ifdef _WIN32
+#define COBJMACROS
+#include <windows.h>
+#include <sapi.h>
+#include <mmsystem.h>
+#include <stdio.h>
+
+static const GUID my_CLSID_SpVoice = {0x96749377, 0x3391, 0x11d2, {0x9e, 0xe3, 0x00, 0xc0, 0x4f, 0x79, 0x73, 0x96}};
+static const GUID my_IID_ISpVoice = {0x6c44df74, 0x72b9, 0x4992, {0xa1, 0xec, 0xef, 0x99, 0x6e, 0x04, 0x22, 0xd4}};
+
+enum { MAXT = 2048 };
+#define MSG_HOLDER 0x84e990b8ULL
+#define MSG_TEXT 0x58
+#define MSG_LEN 0x60
+#define MSG_PAGE 0x48
+
+static int in_heap(uint64_t p) {   /* (readable guest memory, asked of Windows: the text may live outside the heap) */
+    if (p < 0x10000 || p >= 0x10000000000ULL) return 0;
+    MEMORY_BASIC_INFORMATION mi;
+    if (!VirtualQuery(A64_PTR(p), &mi, sizeof mi) || mi.State != MEM_COMMIT) return 0;
+    if (mi.Protect & (PAGE_NOACCESS | PAGE_GUARD)) return 0;
+    return (const char *)mi.BaseAddress + mi.RegionSize - (const char *)A64_PTR(p) >= 16;
+}
+static uint64_t g64(uint64_t a) { uint64_t v; memcpy(&v, A64_PTR(a), 8); return v; }
+static uint32_t g32(uint64_t a) { uint32_t v; memcpy(&v, A64_PTR(a), 4); return v; }
+
+/* A game-data number by name, read as the game's getters do (host/hos_main.c oot_gamedata_word): MurmurHash3 of the name in
+   each of the word tables' hash index. For a message's "variable" tag (group 2 tag 1, its parameters u16 length then the
+   name, "Npc_Hylia_049_Child_HowManyCuccos"), which the game fills in as it shows the text. */
+static uint32_t murmur3(const char *s, size_t n) {
+    uint32_t h = 0, k;
+    size_t i = 0;
+    for (; i + 4 <= n; i += 4) {
+        memcpy(&k, s + i, 4);
+        k *= 0xcc9e2d51u, k = k << 15 | k >> 17, k *= 0x1b873593u;
+        h ^= k, h = h << 13 | h >> 19, h = h * 5 + 0xe6546b64u;
+    }
+    k = 0;
+    for (size_t j = n - i; j; j--) k = k << 8 | (uint8_t)s[i + j - 1];
+    if (n - i) k *= 0xcc9e2d51u, k = k << 15 | k >> 17, k *= 0x1b873593u, h ^= k;
+    h ^= (uint32_t)n, h ^= h >> 16, h *= 0x85ebca6bu, h ^= h >> 13, h *= 0xc2b2ae35u, h ^= h >> 16;
+    return h;
+}
+static int game_number(const char *name, size_t n, int *value) {
+    const uint64_t mgr = hos_oot_gamedata_mgr;
+    if (!in_heap(mgr) || !n) return 0;
+    const uint32_t hash = murmur3(name, n);
+    for (uint32_t t = 0; t < 17; t++) {
+        const uint64_t off = mgr + 0x10 + 0x60 * t;
+        const uint64_t entries = g64(off + 8);
+        const uint32_t count = g32(off);
+        if (!in_heap(entries) || !count || count > 20000) continue;
+        for (uint32_t e = 0; e < count; e++) {   /* (each 0x28-byte entry: its key first, the value at +0x1c) */
+            const uint64_t at = entries + 0x28ULL * e;
+            if (g32(at) == hash || g32(at + 4) == hash) {
+                *value = (int)g32(at + 0x1c);
+                static int told;
+                if (told < 20) told++, hos_log("voice: game number \"%.*s\" = %d (table %u entry %u)", (int)n, name, *value, t, e);
+                return 1;
+            }
+        }
+    }
+    return 0;
+}
+
+/* A message argument the game set for the box (found 2026-11-12 with the Cucco Lady's "Only 7 left to find!" up): a record
+   {u16 name length, the name, 0} in the guest's upper memory (0x7fxxxxxxxx, near 0x7fff985360 then), its type at +0x28 (2: a
+   number) and the number at +0x38. Searched in that range's committed regions under 64 MB. */
+static int message_argument(const char *name, size_t n, int *value, char *text, int tmax) {
+    unsigned char key[160];
+    if (n + 3 > sizeof key) return 0;
+    key[0] = (unsigned char)n, key[1] = (unsigned char)(n >> 8);
+    memcpy(key + 2, name, n);
+    key[n + 2] = 0;
+    const size_t kl = n + 3;
+    const unsigned char *lo = (const unsigned char *)A64_PTR(0x7f00000000ULL), *hi = (const unsigned char *)A64_PTR(0x8000000000ULL);
+    for (const unsigned char *a = lo; a < hi;) {
+        MEMORY_BASIC_INFORMATION mi;
+        if (!VirtualQuery(a, &mi, sizeof mi)) break;
+        const unsigned char *base = (const unsigned char *)mi.BaseAddress, *end = base + mi.RegionSize;
+        if (mi.State == MEM_COMMIT && !(mi.Protect & (PAGE_NOACCESS | PAGE_GUARD)) && (mi.Protect & (PAGE_READWRITE | PAGE_READONLY)) &&
+            mi.RegionSize < (64u << 20)) {
+            for (const unsigned char *q = base; q + 0x40 <= end;) {
+                q = memchr(q, key[2], (size_t)(end - 0x40 - q));
+                if (!q) break;
+                if (q >= base + 2 && !memcmp(q - 2, key, kl)) {
+                    const unsigned char *r = q - 2;
+                    uint16_t type;
+                    memcpy(&type, r + 0x28, 2);
+                    static int told;
+                    if (type == 2) {
+                        memcpy(value, r + 0x38, 4);
+                        if (told < 20) told++, hos_log("voice: message argument \"%.*s\" = %d", (int)n, name, *value);
+                        return 1;
+                    }
+                    /* (other types: the slot as a pointer to text, a name or an item's, if it reads as one) */
+                    uint64_t ptr;
+                    memcpy(&ptr, r + 0x38, 8);
+                    if (in_heap(ptr) && text) {
+                        int k = 0;
+                        const unsigned char *t = (const unsigned char *)A64_PTR(ptr);
+                        while (k < tmax - 1 && t[k] >= 0x20) text[k] = (char)t[k], k++;
+                        text[k] = 0;
+                        if (k >= 1 && !t[k]) {
+                            if (told < 20) told++, hos_log("voice: message argument \"%.*s\" (type %u) = \"%s\"", (int)n, name, type, text);
+                            return 2;
+                        }
+                    }
+                    static int odd;
+                    if (odd < 20) {
+                        odd++;
+                        char hex[3 * 0x40 + 1];
+                        for (int j = 0; j < 0x40; j++) snprintf(hex + 3 * j, 4, "%02x ", r[j]);
+                        hos_log("voice: message argument \"%.*s\" of type %u not read: %s", (int)n, name, type, hex);
+                    }
+                }
+                q++;
+            }
+        }
+        a = end > a ? end : a + 4096;
+    }
+    return 0;
+}
