+/* Piper (piper\ beside the exe: piper.exe and en_US-lessac-medium.onnx), a natural voice run on this PC: one process kept
+   running, a line of text in on its stdin, the path of the .wav it made out on its stdout; played with PlaySound */
+typedef struct { HANDLE in, out, proc; int speed; const wchar_t *model; } Piper;
+static Piper piper_main = {0, 0, 0, 0, L"en_US-lessac-medium.onnx"}, piper_cast = {0, 0, 0, 0, L"en_US-libritts_r-medium.onnx"},
+             piper_custom = {0, 0, 0, 0, NULL};   /* (the player's own: the first piper\custom\*.onnx) */
+static int piper_failed;
+static wchar_t piper_dir[MAX_PATH];
+static void piper_stop_process(Piper *pp) {
+    if (pp->proc) TerminateProcess(pp->proc, 0), CloseHandle(pp->proc);
+    if (pp->in) CloseHandle(pp->in);
+    if (pp->out) CloseHandle(pp->out);
+    pp->proc = pp->in = pp->out = NULL;
+}
+static int piper_start(Piper *pp, int speed) {
+    if (pp->proc && speed == pp->speed) return 1;
+    piper_stop_process(pp);
+    if (piper_failed) return 0;
+    DWORD n = GetModuleFileNameW(NULL, piper_dir, MAX_PATH);
+    while (n && piper_dir[n - 1] != L'\\') n--;
+    piper_dir[n] = 0;
+    wcscat(piper_dir, L"piper");
+    wchar_t exe[MAX_PATH], cmd[1024], out[MAX_PATH];
+    swprintf(exe, MAX_PATH, L"%ls\\piper.exe", piper_dir);
+    if (GetFileAttributesW(exe) == INVALID_FILE_ATTRIBUTES) {
+        piper_failed = 1;
+        hos_log("voice: no piper\\piper.exe beside the game: the Windows voice instead");
+        return 0;
+    }
+    swprintf(out, MAX_PATH, L"%ls\\%ls", piper_dir, pp->model);
+    if (GetFileAttributesW(out) == INVALID_FILE_ATTRIBUTES) {
+        hos_log("voice: no piper\\%ls", pp->model);
+        return 0;
+    }
+    swprintf(out, MAX_PATH, L"%ls\\out", piper_dir);
+    CreateDirectoryW(out, NULL);
+    swprintf(cmd, 1024, L"\"%ls\" --model %ls --output_dir out --json-input --length_scale %.2f --sentence_silence 0.15 -q",
+             exe, pp->model, 100.0 / (speed > 0 ? speed : 100));
+    SECURITY_ATTRIBUTES sa = {sizeof sa, NULL, TRUE};
+    HANDLE in_r, in_w, out_r, out_w;
+    if (!CreatePipe(&in_r, &in_w, &sa, 0)) return piper_failed = 1, 0;
+    if (!CreatePipe(&out_r, &out_w, &sa, 0)) return CloseHandle(in_r), CloseHandle(in_w), piper_failed = 1, 0;
+    SetHandleInformation(in_w, HANDLE_FLAG_INHERIT, 0);
+    SetHandleInformation(out_r, HANDLE_FLAG_INHERIT, 0);
+    STARTUPINFOW si = {sizeof si};
+    si.dwFlags = STARTF_USESTDHANDLES;
+    si.hStdInput = in_r, si.hStdOutput = out_w;
+    si.hStdError = CreateFileW(L"NUL", GENERIC_WRITE, FILE_SHARE_WRITE, &sa, OPEN_EXISTING, 0, NULL);
+    PROCESS_INFORMATION pi;
+    const BOOL ok = CreateProcessW(exe, cmd, NULL, NULL, TRUE, CREATE_NO_WINDOW, NULL, piper_dir, &si, &pi);
+    CloseHandle(in_r), CloseHandle(out_w), CloseHandle(si.hStdError);
+    if (!ok) {
+        hos_log("voice: piper did not start (error %lu): the Windows voice instead", GetLastError());
+        CloseHandle(in_w), CloseHandle(out_r);
+        return piper_failed = 1, 0;
+    }
+    CloseHandle(pi.hThread);
+    pp->proc = pi.hProcess, pp->in = in_w, pp->out = out_r, pp->speed = speed;
+    hos_log("voice: natural voice (piper, %ls) ready at %d%% speed", pp->model, speed);
+    return 1;
+}
+/* speaks the words; returns how long the clip is in ns, 0 when piper failed */
+/* one sentence through piper: its samples (16-bit mono 22050 Hz) added to *pcm; 0 when piper failed */
+static int piper_sentence(Piper *pp, const char *u8, int speaker, short **pcm, int *n, int *cap) {
+    static char line[MAXT * 6];
+    int m = snprintf(line, 32, "{\"text\": \"");
+    for (const char *c = u8; *c && m < (int)sizeof line - 48; c++) {   /* (JSON: quotes and backslashes escaped) */
+        if (*c == '"' || *c == '\\') line[m++] = '\\';
+        line[m++] = *c;
+    }
+    m += speaker >= 0 ? snprintf(line + m, 48, "\", \"speaker_id\": %d}\n", speaker) : snprintf(line + m, 48, "\"}\n");
+    DWORD wrote;
+    if (!WriteFile(pp->in, line, (DWORD)m, &wrote, NULL)) { piper_stop_process(pp); return 0; }
+    char path[MAX_PATH * 2];
+    int k = 0;
+    for (;;) {   /* (one line back: the .wav's path) */
+        char ch;
+        DWORD got;
+        if (!ReadFile(pp->out, &ch, 1, &got, NULL) || !got) { hos_log("voice: piper stopped"); piper_stop_process(pp); return 0; }
+        if (ch == '\n') break;
+        if (ch != '\r' && k < (int)sizeof path - 1) path[k++] = ch;
+    }
+    path[k] = 0;
+    wchar_t wav[MAX_PATH];
+    if (!MultiByteToWideChar(CP_UTF8, 0, path, -1, wav, MAX_PATH)) return 0;
+    if (wav[0] && wav[1] != L':') {   /* (relative to piper's folder) */
+        wchar_t full[MAX_PATH];
+        swprintf(full, MAX_PATH, L"%ls\\%ls", piper_dir, wav);
+        wcscpy(wav, full);
+    }
+    FILE *f = _wfopen(wav, L"rb");
+    if (!f) return 0;
+    fseek(f, 0, SEEK_END);
+    const long size = ftell(f);
+    fseek(f, 44, SEEK_SET);
+    const int got = size > 44 ? (int)((size - 44) / 2) : 0;
+    if (*n + got > *cap) {
+        *cap = (*n + got) * 2 + 22050;
+        short *p2 = realloc(*pcm, (size_t)*cap * sizeof(short));
+        if (!p2) return fclose(f), DeleteFileW(wav), 0;
+        *pcm = p2;
+    }
+    const int r = (int)fread(*pcm + *n, 2, (size_t)got, f);
+    fclose(f);
+    DeleteFileW(wav);
+    *n += r;
+    return 1;
+}
+
+/* the sentence's tone, by how it ends: "!" a little faster, higher and louder; "?" its last part rising; "..." a longer
+   pause after. Done on the samples from `from` on: resampled at a rate (above 1 = shorter and higher) */
+static double voice_shift = 1.0;   /* (the whole voice raised: Link's; set around piper_say) */
+static void tone(short *pcm, int from, int *n, int excited, int asks) {
+    const int len = *n - from;
+    if (len <= 0 || (!excited && !asks && voice_shift == 1.0)) return;
+    short *src = malloc((size_t)len * sizeof(short));
+    if (!src) return;
+    memcpy(src, pcm + from, (size_t)len * sizeof(short));
+    const float gain = excited ? 1.3f : 1.0f;
+    double pos = 0;
+    int o = 0;
+    while (pos < len - 1 && o < len) {
+        const double f = pos / len;
+        double rate = (excited ? 1.07 : 1.0) * voice_shift;
+        if (asks && f > 0.55) rate *= 1.0 + 0.16 * (f - 0.55) / 0.45;   /* (the end rising, as a question) */
+        const int i = (int)pos;
+        const double t = pos - i;
+        float v = (float)((1 - t) * src[i] + t * src[i + 1]) * gain;
+        if (v > 32767) v = 32767;
+        if (v < -32768) v = -32768;
+        pcm[from + o++] = (short)v;
+        pos += rate;
+    }
+    *n = from + o;
+    free(src);
+}
+
+/* speaks the words, a sentence at a time; returns how long it is in ns, 0 when piper failed */
+static int64_t piper_say(Piper *pp, const wchar_t *words, int speaker) {
+    static char u8[MAXT * 3];
+    if (WideCharToMultiByte(CP_UTF8, 0, words, -1, u8, sizeof u8, NULL, NULL) <= 1) return 0;
+    static short *pcm;
+    static int cap;
+    int n = 0;
+    PlaySoundW(NULL, NULL, 0);   /* (before pcm is written again: PlaySound reads it while it plays) */
+    char *c = u8;
+    while (*c) {
+        while (*c == ' ') c++;
+        if (!*c) break;
+        char *e = c;   /* (to the end of the sentence: its . ! ? and any more of them, then a space or the end) */
+        while (*e && !(strchr(".!?", *e) && (!e[1] || e[1] == ' ' || strchr(".!?\"'", e[1])))) e++;
+        while (*e && strchr(".!?\"'", *e)) e++;
+        const char keep = *e;
+        *e = 0;
+        const int excited = strchr(c, '!') != NULL, asks = strchr(c, '?') != NULL, trails = strstr(c, "...") != NULL;
+        const int from = n;
+        if (!piper_sentence(pp, c, speaker, &pcm, &n, &cap)) return 0;
+        tone(pcm, from, &n, excited, asks);
+        const int pause = trails ? 22050 * 45 / 100 : 0;   /* (piper ends each sentence with its own short pause) */
+        if (pause && n + pause <= cap) memset(pcm + n, 0, (size_t)pause * sizeof(short)), n += pause;
+        *e = keep;
+        c = e;
+    }
+    if (!n) return 0;
+    static unsigned char *wav;
+    static size_t wav_cap;
+    const size_t bytes = (size_t)n * 2;
+    if (bytes + 44 > wav_cap) {
+        unsigned char *w2 = realloc(wav, bytes + 44);
+        if (!w2) return 0;
+        wav = w2, wav_cap = bytes + 44;
+    }
+    const uint32_t rate = 22050, riff = (uint32_t)bytes + 36, fmt = 16, br = rate * 2, data = (uint32_t)bytes;
+    const uint16_t pcm_fmt = 1, ch = 1, align = 2, bits = 16;
+    memcpy(wav, "RIFF", 4), memcpy(wav + 4, &riff, 4), memcpy(wav + 8, "WAVEfmt ", 8), memcpy(wav + 16, &fmt, 4);
+    memcpy(wav + 20, &pcm_fmt, 2), memcpy(wav + 22, &ch, 2), memcpy(wav + 24, &rate, 4), memcpy(wav + 28, &br, 4);
+    memcpy(wav + 32, &align, 2), memcpy(wav + 34, &bits, 2), memcpy(wav + 36, "data", 4), memcpy(wav + 40, &data, 4);
+    memcpy(wav + 44, pcm, bytes);
+    if (!PlaySoundW((LPCWSTR)wav, NULL, SND_MEMORY | SND_ASYNC | SND_NODEFAULT)) {
+        hos_log("voice: PlaySound could not play the line");
+        return 0;
+    }
+    return (int64_t)n * 1000000000LL / 22050;
+}
+#include "oot_voice_cast.h"
+/* who speaks: the message object's +0x28 is the event's actors, slots 0x60 apart from +0x40, each with its name at +0x20
+   ("Npc_Hylia_Soldier_001"; found 2026-11-12 with a soldier's box up); the first Npc_ one */
+static int speaker_name(uint64_t obj, char *out, int max) {
+    const uint64_t arr = g64(obj + 0x28);
+    if (!in_heap(arr)) return 0;
+    for (int i = 0; i < 8; i++) {
+        const uint64_t slot = g64(arr + 0x40 + 0x60 * i);
+        if (!in_heap(slot)) continue;
+        const uint64_t nm = g64(slot + 0x20);
+        if (!in_heap(nm)) continue;
+        int k = 0;
+        for (; k < max - 1; k++) {
+            const char ch = *(const char *)A64_PTR(nm + k);
+            if (!ch) break;
+            out[k] = ch;
+        }
+        out[k] = 0;
+        if (!strncmp(out, "Npc_", 4)) return 1;
+    }
+    return 0;
+}
+/* the whole of +0x28's list, for the log: every named slot in order, and an order-free hash of the set (is it the event's
+   cast, or only who speaks? the carpenters' scene, three actors in one talk, tells) */
+static uint32_t cast_list(uint64_t obj, char *out, int max) {
+    out[0] = 0;
+    const uint64_t arr = in_heap(obj) ? g64(obj + 0x28) : 0;
+    if (!in_heap(arr)) return 0;
+    uint32_t set = 0;
+    int n = 0;
+    for (int i = 0; i < 8; i++) {
+        const uint64_t slot = g64(arr + 0x40 + 0x60 * i);
+        if (!in_heap(slot)) continue;
+        const uint64_t nm = g64(slot + 0x20);
+        if (!in_heap(nm)) continue;
+        char name[64];
+        int k = 0;
+        for (; k < 63; k++) {
+            const char ch = *(const char *)A64_PTR(nm + k);
+            if (!ch || ch < 32 || ch > 126) break;
+            name[k] = ch;
+        }
+        name[k] = 0;
+        if (!k) continue;
+        uint32_t h = 2166136261u;
+        for (int j = 0; j < k; j++) h = (h ^ (uint8_t)name[j]) * 16777619u;
+        if (!strncmp(name, "Npc_", 4) || !strncmp(name, "Enemy_", 6)) set += h;   /* (people only: scenery names vary) */
+        if (n < max - 2) n += snprintf(out + n, (size_t)(max - n), "%s%d:%s", n ? " " : "", i, name);
+    }
+    return set;
+}
+/* the voice for a speaker: m man, f woman, b boy, g girl; 0 unknown (the main voice) */
+static char speaker_kind(const char *name) {
+    static const struct { const char *part; char kind; } named[] = {
+        {"Saria", 'g'}, {"Fado", 'g'}, {"Malon_Child", 'g'}, {"Ruto_Child", 'g'}, {"Zelda_Child", 'g'}, {"Mido", 'b'},
+        {"Malon", 'f'}, {"Impa", 'f'}, {"Zelda", 'f'}, {"Ruto", 'f'}, {"Nabooru", 'f'}, {"Sheik", 'f'}, {"GreatFairy", 'f'},
+        {"Twinrova", 'f'}, {"Navi", 'f'}, {"Ganondorf", 'm'}, {"Darunia", 'm'}, {"Talon", 'm'}, {"Ingo", 'm'},
+        {"Dampe", 'm'}, {"KingZora", 'm'}, {"Kaepora", 'm'}, {"Rauru", 'm'}, {"Carpenter", 'm'}, {"Soldier", 'm'},
+        {"SkullKid", 'b'}, {"SkullChild", 'b'}, {"DekuTree", 'b'}, {"Pierre", 'm'}, {"GuidePoe", 'm'}};
+    for (size_t i = 0; i < sizeof named / sizeof *named; i++)
+        if (strstr(name, named[i].part)) return named[i].kind;
+    size_t best = 0;
+    char kind = 0;
+    for (size_t i = 0; i < sizeof cast / sizeof *cast; i++) {   /* (the longest table name that starts the speaker's) */
+        const size_t l = strlen(cast[i].name);
+        if (l > best && !strncmp(name, cast[i].name, l)) best = l, kind = cast[i].kind;
+    }
+    if (kind) return kind;
+    if (!strncmp(name, "Npc_Goron", 9) || !strncmp(name, "Npc_Zora", 8)) return 'm';
+    if (!strncmp(name, "Npc_Gerudo", 10)) return 'f';
+    if (!strncmp(name, "Npc_Kokiri", 10)) return 'b';
+    return 0;
+}
+/* a voice of the many-voiced model for this speaker: the same one each time, from voices measured by pitch */
+static int speaker_voice(const char *name, char kind) {
+    static const short man[] = {8, 36, 48, 52, 124, 132, 156, 248, 272, 288, 296, 332, 380, 388, 400, 428, 432, 452, 496, 500,
+                                512, 520, 528, 544, 552, 564, 568, 596, 636, 660, 680, 684, 700, 704, 720, 724, 736, 740};
+    static const short woman[] = {4, 12, 40, 76, 108, 128, 164, 180, 188, 192, 228, 252, 280, 316, 336, 340, 344, 348, 352,
+                                  372, 384, 412, 420, 424, 444, 464, 532, 560, 576, 580, 588, 628, 656, 708, 764, 820};
+    static const short girl[] = {20, 60, 68, 100, 140, 148, 172, 396, 408, 448, 488, 548, 556, 624, 664, 796, 840};
+    static const short boy[] = {0, 56, 64, 80, 96, 112, 120, 144, 160, 184, 196, 220, 224, 236, 240, 244, 260, 268, 276, 292};
+    uint32_t h = 2166136261u;
+    for (const char *c = name; *c; c++) h = (h ^ (unsigned char)*c) * 16777619u;
+    switch (kind) {
+    case 'm': return man[h % (sizeof man / sizeof *man)];
+    case 'f': return woman[h % (sizeof woman / sizeof *woman)];
+    case 'g': return girl[h % (sizeof girl / sizeof *girl)];
+    default: return boy[(h >> 8) % (sizeof boy / sizeof *boy)];
+    }
+}
+
+static void hush(ISpVoice *v) {
+    ISpVoice_Speak(v, L"", SPF_ASYNC | SPF_PURGEBEFORESPEAK, NULL);
+    PlaySoundW(NULL, NULL, 0);
+}
+
+/* the renderer's back end, which exports the cue flag below */
+static HMODULE vk_module(void) {
+    return GetModuleHandleA("longshot_vk.dll");
+}
+/* the renderer's "press next" rainbow frame (gpu/vk/vk_menu.cpp, mkwvk_voice_glow) */
+static volatile int *glow_flag;
+static int64_t glow_since;
+static void glow(int on) {
+    if (!glow_flag) {
+        HMODULE m = vk_module();
+        if (m) glow_flag = (volatile int *)GetProcAddress(m, "mkwvk_voice_glow");
+        if (!glow_flag) return;
+    }
+    if (on && !*glow_flag) glow_since = hos_now_ns();
+    *glow_flag = on;
+}
+
+/* says the words: the speaker's own voice (or the main one), else the Windows voice. who: 1 the box's speaker, 0 the
+   Link (the game's choices) */
+/* Link's voice for his replies (the choices): one boy voice of the many-voiced model, the same all game. (An adult Link
+   voice would go here once his age can be read.) */
+/* (candidates: men's voices of the model, the brightest first, by measured pitch (125-160 Hz; women measured 170+);
+   Insert > Audio > Link's voice; his pitch row raises them) */
+static const short link_voices[] = {632, 604, 508, 436, 476, 320, 852, 828, 668, 88, 308, 456, 28, 728, 816, 284};
+#define LINK_VOICE link_voices[link_pick()]
+static int link_pick(void) {
+    const int i = rx_option(OPT_LINK_VOICE, 0);
+    const int last = (int)(sizeof link_voices / sizeof *link_voices) - 1;
+    return i < 0 ? 0 : i > last ? last : i;
+}
+/* the player's own voice for "Custom": the first .onnx in piper\custom (with its .onnx.json beside it); 0 when none */
+static int custom_model(void) {
+    static wchar_t name[MAX_PATH];
+    static int64_t looked;
+    const int64_t now = hos_now_ns();
+    if (piper_custom.model && piper_custom.proc) return 1;
+    if (looked && now - looked < 10000000000LL) return piper_custom.model != NULL;   /* (looked again every 10 s) */
+    looked = now;
+    if (!piper_dir[0]) {   /* (piper's folder, as piper_start finds it) */
+        DWORD n = GetModuleFileNameW(NULL, piper_dir, MAX_PATH);
+        while (n && piper_dir[n - 1] != L'\\') n--;
+        piper_dir[n] = 0;
+        wcscat(piper_dir, L"piper");
+    }
+    wchar_t pat[MAX_PATH];
+    swprintf(pat, MAX_PATH, L"%ls\custom\*.onnx", piper_dir);
+    WIN32_FIND_DATAW fd;
+    HANDLE f = FindFirstFileW(pat, &fd);
+    piper_custom.model = NULL;
+    if (f == INVALID_HANDLE_VALUE) return 0;
+    do {
+        wchar_t js[MAX_PATH];
+        swprintf(js, MAX_PATH, L"%ls\custom\%ls.json", piper_dir, fd.cFileName);
+        if (!(fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) && GetFileAttributesW(js) != INVALID_FILE_ATTRIBUTES) {
+            swprintf(name, MAX_PATH, L"custom\%ls", fd.cFileName);
+            piper_custom.model = name;
+            break;
+        }
+    } while (FindNextFileW(f, &fd));
+    FindClose(f);
+    return piper_custom.model != NULL;
+}
+
+static void speak(ISpVoice *v, const wchar_t *words, int who_speaks, int *speaking, int64_t *piper_until) {
+    static int said;
+    int kind = rx_option(OPT_VOICE_KIND, 0);
+    const int speed = rx_option(OPT_VOICE_SPEED, 100);
+    int64_t dur = 0;
+    if (kind == 2) {   /* (Custom: every line in the player's own voice; Link's choices keep his pitch) */
+        static int told;
+        if (custom_model() && piper_start(&piper_custom, speed)) {
+            if (told != 1) told = 1, hos_log("voice: custom voice piper\%ls", piper_custom.model);
+            if (!who_speaks) {
+                const int semis = rx_option(OPT_LINK_PITCH, 3);
+                voice_shift = pow(2.0, (semis < 0 ? 0 : semis > 6 ? 6 : semis) / 12.0);
+            }
+            dur = piper_say(&piper_custom, words, -1);
+            voice_shift = 1.0;
+            if (dur > 0) {
+                if (said < 40) said++, hos_log("voice (custom): \"%.70ls\"", words);
+                *piper_until = hos_now_ns() + dur + 200000000LL, *speaking = 2;
+                return;
+            }
+        }
+        if (told != 2) told = 2, hos_log("voice: Custom chosen but no piper\custom\*.onnx (with its .onnx.json) worked: the natural voice instead");
+        kind = 0;
+    }
+    char who[96] = "";
+    char sk = 0;
+    const uint64_t o2 = g64(MSG_HOLDER);
+    if (who_speaks && in_heap(o2) && speaker_name(o2, who, sizeof who)) sk = speaker_kind(who);
+    if (kind == 0 && sk && piper_start(&piper_cast, speed)) dur = piper_say(&piper_cast, words, speaker_voice(who, sk));
+    if (kind == 0 && !who_speaks && piper_start(&piper_cast, speed)) {   /* (Link's replies: his own voice, always) */
+        static int told = -1;
+        const int semis = rx_option(OPT_LINK_PITCH, 3);
+        if (told != LINK_VOICE * 16 + semis) told = LINK_VOICE * 16 + semis, hos_log("voice: Link's voice is speaker %d, +%d semitones", LINK_VOICE, semis);
+        voice_shift = pow(2.0, (semis < 0 ? 0 : semis > 6 ? 6 : semis) / 12.0);
+        dur = piper_say(&piper_cast, words, LINK_VOICE);
+        voice_shift = 1.0;
+        strcpy(who, "Link"), sk = 'b';
+    }
+    if (kind == 0 && dur <= 0 && piper_start(&piper_main, speed)) dur = piper_say(&piper_main, words, -1);
+    if (dur > 0) {
+        if (said < 40) said++, hos_log("voice (natural, %s %c): \"%.70ls\"", who[0] ? who : "?", sk ? sk : '-', words);
+        *piper_until = hos_now_ns() + dur + 200000000LL, *speaking = 2;
+    } else {
+        ISpVoice_SetRate(v, (speed - 100) / 10);
+        const HRESULT hr = ISpVoice_Speak(v, words, SPF_ASYNC | SPF_PURGEBEFORESPEAK | SPF_IS_NOT_XML, NULL);
+        if (said < 40) said++, hos_log("voice (Windows, %#lx): \"%.80ls\"", (unsigned long)hr, words);
+        *speaking = 1;
+    }
+}
+
+/* The choice menu (found 2026-11-12 on "Death Mountain? / Bye."): global 0x84ea4510 -> +0x200 -> +0x1b8 is the choice
+   window; its buttons at +0x418 + 0x20*i, each pointing into a block that holds the choice's text object {u32 length,
+   ..., text pointer at +0x40} somewhere in its first 0x2000 bytes; the highlighted one (from 0) at window +0x85c.
+   Returns a signature of the choices (0: no menu); the list as "A. B. C." and/or the highlighted one's words. */
+#define CHOICE_ROOT 0x84ea4510ULL
+static int safe_read(uint64_t a, void *out, size_t n) {   /* (never faults: a menu's memory may be half gone) */
+    SIZE_T got = 0;
+    return ReadProcessMemory(GetCurrentProcess(), A64_PTR(a), out, n, &got) && got == n;
+}
+static uint64_t s64(uint64_t a) { uint64_t v = 0; return safe_read(a, &v, 8) ? v : 0; }
+/* why the menu was not read, logged when it changes (so a run shows where it stops) */
+static void choice_why(int why, uint32_t a, uint32_t b) {
+    static int last = -1, told;
+    if (why == last || told >= 60) return;
+    last = why, told++;
+    static const char *const say[] = {"choice menu read", "choice window not found via 0x84ea4510 -> +0x200",
+                                      "choice window: no count/cursor", "choice window: count/cursor out of range",
+                                      "choice button not readable", "choice button: no text object", "choice text has no words"};
+    hos_log("voice: %s (last choice %u, cursor %u)", say[why], a, b);
+}
+static uint32_t choice_last;   /* (the open menu's last choice index, for the choice glow) */
+static uint64_t choice_win;     /* (the choice window's address: a new one, a new menu) */
+static int choice_glow_on;     /* (the list was just read: the choice arrow glows until anything changes) */
+static int list_said;          /* (the list's read was started: arms the glow once, when it ends) */
+static int convo_gen;          /* (+1 each time the box opens (+0x30 from -1 to a value): a new conversation, all fresh) */
+static int menu_stale;         /* (a page came after the choices: the menu's memory is old, its cursor not read) */
+static void choice_disarm(const char *why) {   /* (never stuck: the flag back to 0 whatever the menu's memory says) */
+    if (choice_glow_on || list_said) hos_log("voice: choice glow off (%s)", why);
+    choice_glow_on = list_said = 0;
+    if (glow_flag && *glow_flag >= 0x100) glow(0);
+}
+static uint32_t choice_menu(wchar_t *list, int lmax, int *cursor, wchar_t *one, int omax) {
+    if (list && lmax) list[0] = 0;
+    if (one && omax) one[0] = 0;
+    const uint64_t r = s64(CHOICE_ROOT);
+    const uint64_t n = r ? s64(r + 0x200) : 0;
+    if (!n) return choice_why(1, 0, 0), 0;
+    const uint64_t w = n + 0x1b8;   /* (the window: +0x4d0 the last choice's index, +0x4e4 the highlighted one; seen with
+                                       3 choices (2) and 2 (1)) */
+    uint32_t last, cur;
+    if (!safe_read(w + 0x4d0, &last, 4) || !safe_read(w + 0x4e4, &cur, 4)) return choice_why(2, 0, 0), 0;
+    if (last < 1 || last > 3 || cur > last) return choice_why(3, last, cur), 0;
+    uint32_t sig = 2166136261u;
+    int l = 0;
+    static unsigned char blk[0x2048];
+    for (uint32_t i = 0; i <= last; i++) {
+        const uint64_t b = s64(w + 0x418 + 0x20 * i);
+        if (!b || !safe_read(b, blk, sizeof blk)) return choice_why(4, last, cur), 0;
+        unsigned char tx[256];
+        wchar_t wd[256];
+        int found = 0;   /* (the first candidate {length, ..., text at +0x40} whose text has words: junk can come first) */
+        for (uint32_t o = 0; o + 0x48 <= sizeof blk && !found; o += 8) {
+            uint32_t L;
+            uint64_t t;
+            memcpy(&L, blk + o, 4), memcpy(&t, blk + o + 0x40, 8);
+            if (L < 2 || L > 200 || !safe_read(t, tx, L + 1) || tx[L]) continue;
+            uint32_t k = 0;
+            while (k < L && (tx[k] >= 32 || tx[k] == 10 || tx[k] == 14) && tx[k] != 127) k++;
+            if (k == L && message_words(t, L, wd, 256)) found = 1;
+        }
+        if (!found) return choice_why(5, last, cur), 0;
+        for (const wchar_t *c = wd; *c; c++) sig = (sig ^ (uint32_t)*c) * 16777619u;
+        if (list && l < lmax - 4) {
+            l += swprintf(list + l, (size_t)(lmax - l), L"%ls%ls", l ? L" " : L"", wd);
+            const wchar_t e = l ? list[l - 1] : 0;
+            if (e != L'.' && e != L'?' && e != L'!' && l < lmax - 2) list[l++] = L'.', list[l] = 0;
+        }
+        if (one && i == cur) wcsncpy(one, wd, (size_t)omax - 1), one[omax - 1] = 0;
+    }
+    choice_why(0, last, cur);
+    choice_last = last, choice_win = n;
+    *cursor = (int)cur;
+    return sig;
+}
+
+
+/* the dialogue box on screen: the game drawing its text pane (host/oot_text_size.c calls hos_oot_voice_pane) */
+static volatile int64_t pane_ns;
+/* The box's state fields, as far as known (2026-11-12): +4 a byte, 1 seen with the lodge's choice menu up, 0 after; +0x30
+   -1 when closed. Not yet known for a plain talk without choices, so: the glow comes on after every page read, and goes
+   when one of them turns to its "closed" value (or the box's page goes back to 1, or a minute passes); each change is
+   logged with the raw values, and every 2 s while there is text */
+
+
+static int box_open_now(uint64_t obj) {   /* (speech can end after the box was closed: then no glow) */
+    return in_heap(obj) && g32(obj + 0x30) != 0xffffffffu;
+}
+static DWORD WINAPI voice_thread(void *arg) {
+    (void)arg;
+    if (FAILED(CoInitializeEx(NULL, COINIT_MULTITHREADED))) return 0;
+    ISpVoice *v = NULL;
+    if (FAILED(CoCreateInstance(&my_CLSID_SpVoice, NULL, CLSCTX_ALL, &my_IID_ISpVoice, (void **)&v)) || !v) {
+        hos_log("voice: no Windows voice (SAPI) here; read-aloud off");
+        return 0;
+    }
+    const char *r = getenv("HOS_VOICE_RATE");
+    ISpVoice_SetRate(v, r && *r ? atoi(r) : -1);
+    hos_log("voice: read-aloud ready (Windows voice, the dialogue box's message; HOS_VOICE=0 turns it off)");
+    uint64_t last_text = 0;
+    uint32_t last_hash = 0;
+    int64_t pending_at = 0;
+    int speaking = 0;   /* (1 the Windows voice, 2 piper until piper_until) */
+    int64_t piper_until = 0;
+    wchar_t words[MAXT];
+    int page_read = 0;
+   /* (what is being said is a dialogue page: only that ends in the "press next" glow) */
+    for (;;) {
+        Sleep(100);
+        const int64_t now = hos_now_ns();
+        const uint64_t obj = g64(MSG_HOLDER);
+        static uint64_t seen_obj = 1;
+        static int diag;
+        if (obj != seen_obj && diag < 40) {
+            diag++, seen_obj = obj;
+            hos_log("voice: message object %#llx text %#llx len %u", (unsigned long long)obj,
+                    in_heap(obj) ? (unsigned long long)g64(obj + MSG_TEXT) : 0ULL, in_heap(obj) ? g32(obj + MSG_LEN) : 0u);
+        }
+        if (in_heap(obj)) {   /* (the box opening: a new conversation) */
+            /* (+0x30 is the message's id, -1 between messages. A talk ENDED when the page went to 0 while shut; a pause holds
+               its page and goes on at the next. Measured 2026-11-13: pauses 129-2916 ms, re-talks 1406-2941 ms, so no timer.
+               A different cast of people on opening is a new talk too) */
+            static uint32_t prev30 = 0, open_cast;
+            static int64_t shut_at;
+            static int ended;
+            const uint32_t c30 = g32(obj + 0x30);
+            if (c30 == 0xffffffffu && prev30 != 0xffffffffu) shut_at = now, ended = 0;
+            if (c30 == 0xffffffffu && g32(obj + MSG_PAGE) == 0) ended = 1;
+            if (prev30 == 0xffffffffu && c30 != 0xffffffffu) {
+                char cl[512];
+                const uint32_t cs = cast_list(obj, cl, sizeof cl);
+                const int other = cs && open_cast && cs != open_cast;
+                if (ended || other) {
+                    convo_gen++, last_text = 0, last_hash = 0;
+                    hos_log("voice: box opened (+0x30 %#x) after %lld ms: new conversation %d (%s), read fresh", c30,
+                            (long long)((now - shut_at) / 1000000), convo_gen, ended ? "page went to 0" : "other people");
+                } else {
+                    static int told;
+                    if (told < 60) told++, hos_log("voice: next message (+0x30 %#x) after %lld ms: same conversation (page held)", c30,
+                                                   (long long)((now - shut_at) / 1000000));
+                }
+                if (cs) open_cast = cs;
+            }
+            prev30 = c30;
+            {   /* (the cast: logged at each open and whenever it changes in a box) */
+                static uint32_t last_set = 1;
+                static int told;
+                if (c30 != 0xffffffffu && told < 200) {
+                    char cl[512];
+                    const uint32_t set = cast_list(obj, cl, sizeof cl);
+                    if (set != last_set) told++, last_set = set, hos_log("voice: cast %08x (+0x30 %#x): %s", set, c30, cl[0] ? cl : "(none)");
+                }
+            }
+            if (c30 == 0xffffffffu && now - shut_at > 300000000LL && glow_flag && *glow_flag) {   /* (no box: no glow, ever) */
+                choice_disarm("box shut"), glow(0);
+                hos_log("voice: box shut 300 ms: glow off");
+            }
+        }
+        if (in_heap(obj)) {
+            /* (the message's pages are a ring of nodes {prev, next, flags, len, text...}; +0x58 is the first page's
+               text, +0x48 the page on show, 1 for the first: walk to it) */
+            uint64_t text = g64(obj + MSG_TEXT);
+            uint32_t len = g32(obj + MSG_LEN);
+            const uint32_t page = g32(obj + MSG_PAGE);
+            if (page > 1 && page < 64 && in_heap(text - 0x20)) {
+                const uint64_t first = text - 0x20, head = g64(first);
+                uint64_t node = first;
+                for (uint32_t k = 1; k < page && node; k++) {
+                    node = in_heap(node) ? g64(node + 8) : 0;
+                    if (node == head || node == first || !in_heap(node)) node = 0;
+                }
+                if (node) text = node + 0x20, len = g32(node + 0x18);
+            }
+            if (in_heap(text) && len > 0 && len < 8192) {
+                uint32_t h = 2166136261u;
+                for (uint32_t i = 0; i < len && i < 4096; i++) h = (h ^ *(const unsigned char *)A64_PTR(text + i)) * 16777619u;
+                if (text != last_text || h != last_hash) {
+                    if (diag < 40) diag++, hos_log("voice: new text at %#llx, %u bytes", (unsigned long long)text, len);
+                    choice_disarm("new text");
+                    menu_stale = 1;
+                    static int first = 1;   /* (the message already there when the thread first looks is not new) */
+                    last_text = text, last_hash = h;
+                    glow(0);
+                    if (speaking) hush(v), speaking = 0;   /* (a new page: the last one's voice stops) */
+                    /* (closing the box drops the page back to 1: the same message's first page again is not new) */
+                    static uint32_t page1_hash, last_page;
+                    static int pg_gen;
+                    if (pg_gen != convo_gen) pg_gen = convo_gen, page1_hash = 0, last_page = 0;
+                    const uint32_t pg = page < 64 ? page : 1;
+                    const int back_to_start = pg <= 1 && last_page > 1 && h == page1_hash;
+                    if (pg <= 1) page1_hash = h;
+                    last_page = pg;
+                    if (back_to_start) {
+                        if (diag < 40) diag++, hos_log("voice: back to page 1 of the same message (box closed), not read again");
+                        pending_at = 0;
+                    } else if (message_words(text, len, words, MAXT)) pending_at = now;
+                    first = 0;
+                }
+            }
+        }
+        if (!rx_option(OPT_VOICE_ON, 1)) {   /* (the Insert menu's Read aloud row off) */
+            pending_at = 0;
+            if (speaking) hush(v), speaking = 0;
+            glow(0);
+        }
+        if (pending_at && now - pending_at > 300000000LL) {
+            pending_at = 0;
+            /* (the same prompt again within one conversation, as after a choice is answered: read once; 45 s later it is a
+               new conversation) */
+            static uint32_t heard[16];
+            static int64_t heard_at[16];
+            static int hd_gen;
+            if (hd_gen != convo_gen) hd_gen = convo_gen, memset(heard, 0, sizeof heard), memset(heard_at, 0, sizeof heard_at);   /* (a new talk: all heard afresh; within one, 20 s) */
+            uint32_t wh = 2166136261u;
+            for (const wchar_t *w = words; *w; w++) wh = (wh ^ (uint32_t)*w) * 16777619u;
+            int again = 0, slot = 0;
+            for (int q = 0; q < 16; q++) {
+                if (heard[q] == wh && now - heard_at[q] < 20000000000LL) again = 1, slot = q;
+                else if (heard_at[q] < heard_at[slot]) slot = q;
+            }
+            heard[slot] = wh, heard_at[slot] = now;
+            if (again) {
+                static int told;
+                if (told < 20) told++, hos_log("voice: heard just now, not read again: \"%.50ls\"", words);
+                glow(box_open_now(obj) && rx_option(OPT_VOICE_GLOW, 1));
+                menu_stale = 0, list_said = 1;   /* (back at the prompt: its choices again, the arrow says "your turn") */
+                continue;
+            }
+            static int said;
+            if (hos_voiced_line_ns > now - 2400000000LL) {
+                if (said < 30) said++, hos_log("voice: skipped, the game voices it: \"%.60ls\"", words);
+            } else {
+                speak(v, words, 1, &speaking, &piper_until);
+                page_read = 1;
+            }
+        }
+        {   /* (Link's voice or pitch changed in the menu: a sample) */
+            static int lv = -1, lp = -1;
+            static int64_t began;
+            if (!began) began = now;
+            const int v2 = rx_option(OPT_LINK_VOICE, 0), p2 = rx_option(OPT_LINK_PITCH, 3);
+            if (now - began < 8000000000LL) lv = -1;   /* (the first seconds: the saved settings arriving, not a change) */
+            if (lv >= 0 && (v2 != lv || p2 != lp) && rx_option(OPT_VOICE_ON, 1)) {
+                if (speaking) hush(v), speaking = 0;
+                speak(v, L"Hi! I'm Link! Let's go!", 0, &speaking, &piper_until);
+                page_read = 0;
+            }
+            lv = v2, lp = p2;
+        }
+        /* the choice list: read once after its prompt, then the highlighted choice as the cursor moves */
+        {
+            static uint32_t shown_sig;
+            static int shown_cursor = -1, choices_due;
+            static int64_t cursor_due;
+            static wchar_t list[MAXT];
+            int cursor;
+            const uint32_t sig = in_heap(obj) ? choice_menu(list, MAXT, &cursor, NULL, 0) : 0;
+            if (!in_heap(obj)) shown_sig = 0, choices_due = 0;
+            static int ch_gen;
+            static uint64_t seed_win;
+            if (ch_gen != convo_gen) {   /* (new conversation: what the window holds now is the last menu's, not read; a list
+                                            read only when it changes, or comes in a new window) */
+                ch_gen = convo_gen, choices_due = 0;
+                int c0;
+                shown_sig = in_heap(obj) ? choice_menu(NULL, 0, &c0, NULL, 0) : 0;
+                seed_win = shown_sig ? choice_win : 0;
+                if (shown_sig) shown_cursor = c0;
+                hos_log("voice: new conversation: the choice window holds %08x (window %#llx), not read", shown_sig,
+                        (unsigned long long)seed_win);
+            }   /* (no box: the next menu is new, even the same one) */
+            if (sig && seed_win && choice_win != seed_win) {
+                hos_log("voice: choice window moved %#llx -> %#llx: a new menu", (unsigned long long)seed_win,
+                        (unsigned long long)choice_win);
+                seed_win = 0, shown_sig = 0;
+            }
+            if (!sig && seed_win) seed_win = 0, shown_sig = 0;   /* (the window went: an identical list later is new) */
+            if (sig && sig != shown_sig) {
+                shown_sig = sig, shown_cursor = cursor, choices_due = 1, menu_stale = 0;
+                static int lg;
+                if (lg < 20) lg++, hos_log("voice: choices %08x, cursor %d: \"%.80ls\"", sig, cursor, list);
+            } else if (sig && cursor != shown_cursor && menu_stale) {
+                shown_cursor = cursor;   /* (an old menu's cursor: not the player's, not read) */
+            } else if (sig && cursor != shown_cursor && rx_option(OPT_VOICE_ON, 1)) {
+                /* (the cursor moved: what is being said stops now, the new choice is said once the cursor has rested
+                   200 ms, so holding the stick does not pile up lines) */
+                shown_cursor = cursor, choices_due = 0, pending_at = 0;
+                if (speaking) hush(v), speaking = 0;
+                if (!choice_glow_on) glow(0);
+                cursor_due = now + 200000000LL;
+            }
+            if (cursor_due && now > cursor_due) {
+                cursor_due = 0;
+                wchar_t one[256];
+                int c1;
+                if (sig && !menu_stale && rx_option(OPT_VOICE_ON, 1) && choice_menu(NULL, 0, &c1, one, 256) && c1 == shown_cursor) {
+                    speak(v, one, 0, &speaking, &piper_until);
+                    page_read = 0;
+                    if (!choice_glow_on) list_said = 1;   /* (a cursor read before the first: it arms too) */
+                }
+            }
+            if (choices_due && !pending_at && !speaking && rx_option(OPT_VOICE_ON, 1)) {   /* (after the prompt: the highlighted
+                                                                                             choice only, the user's wish) */
+                choices_due = 0;
+                glow(0);
+                wchar_t one[256];
+                int c1;
+                if (choice_menu(NULL, 0, &c1, one, 256)) speak(v, one, 0, &speaking, &piper_until);
+                page_read = 0;
+                list_said = 1;
+            }
+            /* the choice glow: once the list has been read, the highlighted choice glows (the renderer's flag 0x100 | last
+               choice << 4 | cursor) until the menu goes; no page glow while a menu is up */
+            if (sig) {
+                /* (armed once, as Link STARTS reading the options, not after he has finished: list_said is set the moment
+                   speak() is called, so waiting for !speaking here held the chevron back for a whole utterance. Talking to
+                   the lodge guard, that was his line plus "About the lodge..." plus Piper's synthesis before any cue
+                   appeared. The picture and the voice now arrive together) */
+                if (list_said && !pending_at && !choice_glow_on) choice_glow_on = 1, list_said = 0, hos_log("voice: choice arrow armed (%u choices)", choice_last + 1);
+                if (choice_glow_on && rx_option(OPT_VOICE_GLOW, 1)) {
+                    const int val = 0x100 | (int)choice_last << 4 | cursor;
+                    if (!glow_flag || *glow_flag != val) {
+                        static int lg2;
+                        if (lg2 < 40) lg2++, hos_log("voice: choice glow on choice %d of %u (layout: right half of the box, rows "
+                                                     "spread round 79%% down; list %d chars: \"%.120ls\")", cursor + 1, choice_last + 1, (int)wcslen(list), list);
+                        glow(val);
+                    }
+                } else if (glow_flag && *glow_flag == 1 && !menu_stale && !seed_win) {   /* (a live menu only: an old one in memory must not eat the press-next glow) */
+                    glow(0);
+                }
+            } else {
+                choice_disarm("menu gone");
+            }
+            if (!choice_glow_on && glow_flag && *glow_flag >= 0x100) glow(0);
+        }
+        if (speaking && hos_voiced_line_ns > now - 150000000LL) {   /* (the game began a voiced line: ours stops) */
+            hush(v);
+            speaking = 0;
+        }
+        if (speaking == 1 && !pending_at) {   /* (the page read to its end: the rainbow says "press next") */
+            SPVOICESTATUS st;
+            if (SUCCEEDED(ISpVoice_GetStatus(v, &st, NULL)) && st.dwRunningState == SPRS_DONE)
+                speaking = 0, choice_glow_on ? (void)0 : glow(page_read && box_open_now(obj) && rx_option(OPT_VOICE_GLOW, 1));
+        }
+        if (speaking == 2 && !pending_at && now > piper_until)
+            speaking = 0, choice_glow_on ? (void)0 : glow(page_read && box_open_now(obj) && rx_option(OPT_VOICE_GLOW, 1));
+        {   /* (the box's fields: logged; one turning to "closed" ends the glow) */
+            static uint32_t f4 = 0x100, f30, f48;
+            static int told;
+            static int64_t every;
+            const uint64_t o3 = g64(MSG_HOLDER);
+            if (in_heap(o3)) {
+                const uint32_t n4 = *(const unsigned char *)A64_PTR(o3 + 4), n30 = g32(o3 + 0x30), n48 = g32(o3 + MSG_PAGE);
+                const int changed = f4 != 0x100 && (n4 != f4 || n30 != f30 || n48 != f48);
+                if ((changed || now - every > 2000000000LL) && told < 300 && (changed || speaking || pending_at || (glow_flag && *glow_flag)))
+                    told++, every = now, hos_log("voice: box fields%s: +4=%u +0x30=%#x page=%u glow=%d", changed ? " changed" : "", n4,
+                                                  n30, n48, glow_flag ? *glow_flag : -1);
+                const int closed = f4 != 0x100 && ((f4 && !n4) || (f30 != 0xffffffffu && n30 == 0xffffffffu));
+                if (closed && glow_flag && *glow_flag) glow(0), hos_log("voice: box closed: glow off");
+                if (closed) choice_disarm("box closed");
+                else if (f4 != 0x100 && n48 != f48) choice_disarm("page changed");
+                else if (n30 == 0xffffffffu) choice_disarm("box shut");
+                f4 = n4, f30 = n30, f48 = n48;
+            }
+        }
+        if (glow_flag && *glow_flag && now - glow_since > 60000000000LL) choice_disarm("a minute"), glow(0);   /* (a minute: whatever it was, gone) */
+    }
+}
+
+void hos_oot_voice_start(void) {
+    static volatile LONG started;
+    if (InterlockedExchange(&started, 1)) return;
+    const char *e = getenv("HOS_VOICE");
+    if (e && *e && atoi(e) == 0) return;
+    CloseHandle(CreateThread(NULL, 0, voice_thread, NULL, 0, NULL));
+}
+void hos_oot_voice_pane(Ctx *c, uint64_t pane) { (void)c, (void)pane; pane_ns = hos_now_ns(); hos_oot_voice_start(); }
+#else
+void hos_oot_voice_start(void) {}
+void hos_oot_voice_pane(Ctx *c, uint64_t pane) { (void)c, (void)pane; }
+#endif
