+// (Longshot-Narrator) Read-aloud's "press next" glow: host/oot_voice.c sets this to 1 when the voice has finished the
+// dialogue box's page, 0 when the page changes; a rainbow frame then pulses round the picture so a player who cannot read
+// knows to go on
+extern "C" __declspec(dllexport) volatile int mkwvk_voice_glow = 0;
+// (Longshot-Narrator) The cue's colour. Rainbow keeps the hue turning, as it always did; a chosen colour holds
+// one hue still and lets the pulse and the breathing carry the movement, which is calmer at the screen's edge.
+static float voice_hue(float cycling) {
+    static const float fixed[] = {0.0f, 0.11f, 0.33f, 0.52f, 0.78f, 0.94f};   // gold, green, blue, purple, pink
+    const int c = opts.voice_color;
+    return (c <= 0 || c >= (int)(sizeof fixed / sizeof *fixed)) ? cycling : fixed[c];
+}
+// (the choice glow: host/oot_voice.c's flag 0x100 | last choice << 4 | cursor right after Link read the choices. One rainbow
+// chevron above the list pointing down at it, bobbing. Measured (lodge guard, 2 and 3 choices): the top row's centre at
+// 0.760 - (M-2) * 0.068 of the picture's height, rows 0.058 tall, the list centred 0.887 across; the tip 0.012 above it)
+static void draw_choice_glow(uint32_t w, uint32_t h, int v) {
+    const int M = ((v >> 4) & 15) + 1;
+    const float W = (float)w, H = (float)h;
+    const float pw = std::min(W, H * 16.0f / 9.0f), ph = pw * 9.0f / 16.0f;
+    const float x0 = (W - pw) * 0.5f, y0 = (H - ph) * 0.5f;
+    const double t = prof_now() / 1e9;
+    const float bob = 0.008f * (float)std::sin(t * 3.0);
+    const float tip = 0.760f - (M - 2) * 0.068f - 0.029f - 0.012f + bob;
+    const ImVec2 T(x0 + pw * 0.887f, y0 + ph * tip);
+    const float hw = pw * 0.025f, ht = ph * 0.045f;
+    ImDrawList* dl = ImGui::GetForegroundDrawList();
+    const float pulse = 0.75f + 0.25f * (float)std::sin(t * 3.0);
+    for (int k = 4; k >= 0; k--) {   // (soft wide strokes under a bright one, each arm's hue turning)
+        const float g = 1.0f + k * 0.12f;
+        const ImVec2 L(T.x - hw * g, T.y - ht * g), Rr(T.x + hw * g, T.y - ht * g), Tk(T.x, T.y + k * ph * 0.004f);
+        float r1, g1, b1, r2, g2, b2;
+        ImGui::ColorConvertHSVtoRGB(voice_hue((float)std::fmod(10.0 - t * 0.35, 1.0)), 0.8f, 1.0f, r1, g1, b1);
+        ImGui::ColorConvertHSVtoRGB(voice_hue((float)std::fmod(10.3 - t * 0.35, 1.0)), 0.8f, 1.0f, r2, g2, b2);
+        const float a = (k ? 0.16f : 0.9f) * pulse, th = k ? ph * 0.012f : std::max(2.5f, ph * 0.007f);
+        dl->AddLine(L, Tk, ImGui::GetColorU32(ImVec4(r1, g1, b1, a)), th);
+        dl->AddLine(Tk, Rr, ImGui::GetColorU32(ImVec4(r2, g2, b2, a)), th);
+    }
+    static int logged_m;
+    if (M != logged_m) logged_m = M, logf("menu: choice arrow for %d choices: tip at %.3f across, %.3f down%s", M, 0.887, (double)tip - bob,
+                                            M > 3 ? " (extrapolated)" : "");
+}
+static void draw_voice_glow(uint32_t w, uint32_t h) {
+    const int v = mkwvk_voice_glow;
+    // (Arrow and Both put the chevron over a reply menu. A page that is only waiting to be turned gets no mark of
+    // its own: the game draws its own arrow there, and the halo we used to ring it with sat over the text. The
+    // edge glow still says "press on", under Screen edge and Both)
+    if (v >= 0x100 && (opts.voice_glow == 2 || opts.voice_glow == 3)) draw_choice_glow(w, h, v);
+    if (opts.voice_glow == 2) return;
+    // (a soft edge glow: each edge a gradient from the rim, fading to nothing inward, its colour flowing round the frame;
+    // breathes slowly)
+    ImDrawList* dl = ImGui::GetForegroundDrawList();
+    const double t = prof_now() / 1e9;
+    const float breathe = 0.7f + 0.3f * (float)std::sin(t * 2.2);
+    const float W = (float)w, H = (float)h, m = std::min(W, H);
+    const int seg = 120;
+    auto col = [&](float u, float a) {   // (u: 0..1 round the frame, clockwise from the top left)
+        float r, g, b;
+        ImGui::ColorConvertHSVtoRGB(voice_hue((float)std::fmod(u + 10.0 - t * 0.12, 1.0)), 0.75f, 1.0f, r, g, b);
+        return ImGui::GetColorU32(ImVec4(r, g, b, a));
+    };
+    const ImU32 clear = 0;
+    struct Band { float depth, alpha; };
+    const Band bands[] = {{m * 0.075f, 0.45f * breathe}, {m * 0.022f, 0.55f * breathe}};   // (wide haze, brighter rim)
+    for (const Band& bd : bands) {
+        const float D = bd.depth, A = bd.alpha;
+        for (int i = 0; i < seg; i++) {
+            const float f0 = (float)i / seg, f1 = (float)(i + 1) / seg;
+            // top: left to right, u 0..0.25
+            ImU32 a0 = col(f0 * 0.25f, A), a1 = col(f1 * 0.25f, A);
+            dl->AddRectFilledMultiColor(ImVec2(W * f0, 0), ImVec2(W * f1, D), a0, a1, clear, clear);
+            // right: top to bottom, u 0.25..0.5
+            a0 = col(0.25f + f0 * 0.25f, A), a1 = col(0.25f + f1 * 0.25f, A);
+            dl->AddRectFilledMultiColor(ImVec2(W - D, H * f0), ImVec2(W, H * f1), clear, a0, a1, clear);
+            // bottom: right to left, u 0.5..0.75
+            a0 = col(0.5f + f0 * 0.25f, A), a1 = col(0.5f + f1 * 0.25f, A);
+            dl->AddRectFilledMultiColor(ImVec2(W * (1 - f1), H - D), ImVec2(W * (1 - f0), H), clear, clear, a0, a1);
+            // left: bottom to top, u 0.75..1
+            a0 = col(0.75f + f0 * 0.25f, A), a1 = col(0.75f + f1 * 0.25f, A);
+            dl->AddRectFilledMultiColor(ImVec2(0, H * (1 - f1)), ImVec2(D, H * (1 - f0)), a1, clear, clear, a0);
+        }
+    }
+}
